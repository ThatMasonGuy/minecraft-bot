# Minecraft connection.
MINECRAFT_HOST=localhost
MINECRAFT_PORT=25565
MINECRAFT_USERNAME=AIPlayer
MINECRAFT_AUTH=offline
MINECRAFT_VERSION=1.21.11

# LLM provider configuration. Copy this file to .env and fill in real values.
OPENAI_API_KEY=
OPENAI_MODEL=

# Runtime storage. Keep live memory out of git unless deliberately exported.
DATABASE_URL=file:./runtime/memory.sqlite
MEMORY_DIR=./runtime/memory

# Local debugging tools.
VIEWER_PORT=3007
LOG_LEVEL=info

# Safety switches.
ENABLE_WEB_RESEARCH=true
ALLOW_INSECURE_CODE_EXECUTION=false
PUBLIC_REPO_MODE=true
